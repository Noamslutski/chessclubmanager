<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PTChess" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorPrimaryDark">@color/blue_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorOnSecondary">@color/black_900</item>

        <item name="android:colorBackground">@color/black_800</item>
        <item name="colorSurface">@color/surface_800</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/danger</item>

        <item name="android:statusBarColor">@color/black_900</item>
        <item name="android:navigationBarColor">@color/black_900</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialButtonStyle">@style/Widget.PTChess.Button</item>
        <item name="textInputStyle">@style/Widget.PTChess.TextInput</item>
    </style>

    <style name="Theme.PTChess.Splash" parent="Theme.PTChess">
        <item name="android:windowBackground">@color/black_900</item>
    </style>

    <!-- Rounded, filled brand button -->
    <style name="Widget.PTChess.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/blue_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.PTChess.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/blue_light</item>
        <item name="strokeColor">@color/stroke_600</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PTChess.Button.Gold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/gold_accent</item>
        <item name="android:textColor">@color/black_900</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.PTChess.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/blue_light</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/blue_light</item>
        <item name="android:textColorHint">@color/text_muted</item>
    </style>

    <style name="Card.PTChess" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_800</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/stroke_600</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
