<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/bookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/add_book"
            android:maxLength="120"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/bookAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/book_author"
            android:maxLength="80"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/bookLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/book_language"
            android:maxLength="40"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/book_category"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/bookCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/book_side"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/bookSide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/ratingMin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="min"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/ratingMax"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="max"
                android:inputType="number"
                android:maxLength="4"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:importantForAutofill="no" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChooseFile"
            style="@style/Widget.PTChess.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/upload_pdf" />

        <TextView
            android:id="@+id/txtChosenFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
