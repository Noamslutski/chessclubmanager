<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Row 1: members / active this week -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.PTChess" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="6dp" app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/statMembers" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/gold_accent"
                        android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/gam_members"
                        android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.PTChess" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="6dp" app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/statActive" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/success"
                        android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:text="@string/gam_active_week"
                        android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Row 2: puzzles solved / assignments done / tournaments -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.PTChess" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="6dp" app:contentPadding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/statPuzzlesSolved" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/blue_light"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="@string/gam_puzzles_solved"
                        android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.PTChess" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="6dp" app:contentPadding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/statAssignmentsDone" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/blue_light"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="@string/gam_assignments_done"
                        android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Card.PTChess" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_margin="6dp" app:contentPadding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center">
                    <TextView android:id="@+id/statTournamentsPlayed" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="@color/blue_light"
                        android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:gravity="center"
                        android:text="@string/gam_tournaments"
                        android:textColor="@color/text_secondary" android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingTop="16dp"
            android:paddingBottom="2dp"
            android:text="@string/gam_leaderboard"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerLeaderboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingHorizontal="6dp" />

        <TextView
            android:id="@+id/txtEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/gam_no_members"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
