rules_version = '2';

// Access is driven by Firebase Auth custom claims (clubId, clubIdStr, role) set
// by the setUserClaims Cloud Function. The app now signs in with Firebase Auth and
// reads/writes per-club content directly under clubs/{clubId}/… ; Cloud Functions
// use the Admin SDK (which bypasses rules) for scheduled ingestion.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myClub() { return request.auth.token.clubId; }         // numeric (data comparisons)
    function myClubStr() { return request.auth.token.clubIdStr; }   // string (path comparisons)
    function myRole() { return request.auth.token.role; }
    function isStaff() { return myRole() == "TUTOR" || myRole() == "ADMIN"; }
    function isAdmin() { return myRole() == "ADMIN"; }
    // clubId here is a path segment (a string), so compare against the string claim.
    function inClub(clubId) { return signedIn() && myClubStr() == clubId; }

    // Shared puzzle pool — non-sensitive reference content, so publicly readable
    // (the app reads it before migrating to Firebase Auth). Written only by the
    // ingestion Cloud Function via the Admin SDK.
    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if false;
    }

    // Clubs and their per-club content.
    match /clubs/{clubId} {
      allow read: if inClub(clubId);
      allow update: if inClub(clubId) && isAdmin();
      allow create: if signedIn();

      match /{collection}/{docId} {
        allow read: if inClub(clubId);
        allow create, update, delete: if inClub(clubId) && isStaff();
      }
    }

    // User profiles.
    match /users/{userId} {
      allow read: if request.auth.uid == userId
                  || (signedIn() && isAdmin() && resource.data.clubId == myClub());
      allow update: if request.auth.uid == userId
                    || (signedIn() && isAdmin() && resource.data.clubId == myClub());
      allow create: if request.auth.uid == userId;
    }

    // Registration requests: a signed-up user may create their own; admins read.
    match /registrations/{regId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() && isAdmin();
    }

    // Outgoing mail queue (Trigger Email extension) — functions only.
    match /mail/{docId} {
      allow read, write: if false;
    }
  }
}
